SUPA_URL=https://your-project.supabase.co
SUPA_KEY=your-supabase-service-key
PORT=3000
FRONTEND_URL=http://localhost:5173
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
# Cloudflare Turnstile. These are Cloudflare's always-pass test values; never deploy a test secret.
# Without a secret, holds/lookup/cancel are refused with 503 in production.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
TURNSTILE_HOSTNAMES=localhost
# How many guests per event can be on the seat map at once; the rest wait in the queue.
WAITING_ROOM_CAPACITY=50
