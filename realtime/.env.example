REDIS_URL=redis://localhost:6379
# Service-role key, same as the backend's. Never expose it to the browser.
SUPA_URL=https://your-project.supabase.co
SUPA_KEY=your-supabase-service-key
# Comma-separated origins allowed to open a socket.
ALLOWED_ORIGINS=http://localhost:5173
# Must match the backend's value.
WAITING_ROOM_CAPACITY=50
PORT=3001
# Socket connections allowed per client IP (default 20). A campus NAT shares one IP, so keep it generous.
MAX_SOCKETS_PER_IP=20
# Set to 1 only behind a proxy that sets X-Forwarded-For (Railway, Fly, Render); otherwise the
# header could be forged to dodge the per-IP cap.
TRUST_PROXY=0
